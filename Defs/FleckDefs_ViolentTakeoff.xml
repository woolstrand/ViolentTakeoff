<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Real-time copies of vanilla flecks. The takeoff cutscene keeps the game paused, and game-time flecks
    only advance on ticks; realTime flecks advance every frame (FleckManagerUpdate), so they animate anyway.
  -->

  <FleckDef ParentName="FleckBase">
    <defName>VT_ExplosionFlash</defName>
    <realTime>true</realTime>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <solidTime>0.05</solidTime>
    <fadeOutTime>0.15</fadeOutTime>
    <graphicData>
      <texPath>Things/Mote/ExplosionFlash</texPath>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
  </FleckDef>

  <FleckDef ParentName="FleckBase">
    <defName>VT_BlastDry</defName>
    <realTime>true</realTime>
    <graphicData>
      <texPath>Things/Mote/BlastDry</texPath>
      <shaderType>TransparentPostLight</shaderType>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <solidTime>0</solidTime>
    <fadeOutTime>0.3</fadeOutTime>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VT_DustPuff</defName>
    <realTime>true</realTime>
    <graphicData>
      <texPath>Things/Mote/DustPuff</texPath>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.04</fadeInTime>
    <solidTime>0.03</solidTime>
    <fadeOutTime>1</fadeOutTime>
  </FleckDef>

  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VT_Smoke</defName>
    <realTime>true</realTime>
    <graphicData>
      <texPath>Things/Mote/Smoke</texPath>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.5</fadeInTime>
    <solidTime>6</solidTime>
    <fadeOutTime>3.2</fadeOutTime>
    <growthRate>0.3</growthRate>
  </FleckDef>

  <!-- Stands in for real fires: Fire things do not burn or flicker while the game is paused. -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>VT_FireGlow</defName>
    <realTime>true</realTime>
    <graphicData>
      <texPath>Things/Mote/FireGlow</texPath>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.3</fadeInTime>
    <solidTime>2</solidTime>
    <fadeOutTime>1.5</fadeOutTime>
  </FleckDef>

  <!-- Distortion ring riding the shockwave front. growthRate is set from the speed setting at launch. -->
  <FleckDef ParentName="FleckBase">
    <defName>VT_ShockwaveRing</defName>
    <realTime>true</realTime>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <fadeInTime>0.1</fadeInTime>
    <solidTime>10</solidTime>
    <fadeOutTime>1</fadeOutTime>
    <growthRate>50</growthRate>
    <graphicData>
      <graphicClass>Graphic_FleckPulse</graphicClass>
      <texPath>Things/Mote/Black</texPath>
      <shaderType>MoteLargeDistortionWave</shaderType>
      <shaderParameters>
        <_DistortionTex>/Things/Mote/PsychicDistortionCurrents</_DistortionTex>
        <_NoiseTex>/Things/Mote/PsycastNoise</_NoiseTex>
        <_distortionIntensity>0.12</_distortionIntensity>
        <_brightnessMultiplier>2.5</_brightnessMultiplier>
      </shaderParameters>
      <drawSize>1.0</drawSize>
    </graphicData>
  </FleckDef>
</Defs>
