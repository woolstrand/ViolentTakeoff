<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Multi-targeted: every build produces both game versions.
		  net472   -> RimWorld 1.6 (Unity/Mono)      -> 1.6/Assemblies/ViolentTakeoff.dll
		  net10.0  -> RimWorld 1.7 (Waylith/.NET 10) -> 1.7/Assemblies/ViolentTakeoff.dll
		Game reference DLLs are not committed; put them into References/1.6 and References/1.7
		(see README) or override RefDir16 / RefDir17 on the command line.
	-->
	<PropertyGroup>
		<TargetFrameworks>net472;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<AssemblyName>ViolentTakeoff</AssemblyName>
		<RootNamespace>ViolentTakeoff</RootNamespace>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<Deterministic>false</Deterministic>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<DebugType>none</DebugType>
		<RefDir16 Condition="'$(RefDir16)' == ''">$(MSBuildThisFileDirectory)../../References/1.6/</RefDir16>
		<RefDir17 Condition="'$(RefDir17)' == ''">$(MSBuildThisFileDirectory)../../References/1.7/</RefDir17>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
		<OutputPath>../../1.6/Assemblies/</OutputPath>
		<IntermediateOutputPath>obj/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<OutputPath>../../1.7/Assemblies/</OutputPath>
		<IntermediateOutputPath>obj/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
		<Reference Include="Assembly-CSharp" HintPath="$(RefDir16)Assembly-CSharp.dll" Private="false" />
		<Reference Include="UnityEngine" HintPath="$(RefDir16)UnityEngine.dll" Private="false" />
		<Reference Include="UnityEngine.CoreModule" HintPath="$(RefDir16)UnityEngine.CoreModule.dll" Private="false" />
		<Reference Include="UnityEngine.IMGUIModule" HintPath="$(RefDir16)UnityEngine.IMGUIModule.dll" Private="false" />
		<Reference Include="UnityEngine.TextRenderingModule" HintPath="$(RefDir16)UnityEngine.TextRenderingModule.dll" Private="false" />
		<Reference Include="0Harmony" HintPath="$(RefDir16)0Harmony.dll" Private="false" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Reference Include="Assembly-CSharp" HintPath="$(RefDir17)Assembly-CSharp.dll" Private="false" />
		<Reference Include="UnityStubs" HintPath="$(RefDir17)UnityStubs.dll" Private="false" />
		<Reference Include="Waylith" HintPath="$(RefDir17)Waylith.dll" Private="false" />
		<Reference Include="0Harmony" HintPath="$(RefDir17)0Harmony.dll" Private="false" />
	</ItemGroup>

	<!-- Deploy into the game's Mods folder once both targets are built (outer build only). -p:Deploy=false to skip. -->
	<Target Name="DeployMod" AfterTargets="Build" Condition="'$(TargetFramework)' == '' And '$(Deploy)' != 'false' And '$(OS)' != 'Windows_NT'">
		<Exec Command="bash &quot;$(MSBuildThisFileDirectory)../../deploy.sh&quot;" />
	</Target>
</Project>
